# AI Interview Coach Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MySQL Relational Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ai_interview_coach

# Authentication
JWT_SECRET=super_secret_jwt_key_replace_with_min_32_characters_random_string
JWT_EXPIRES_IN=7d

# AI Integration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Client CORS
CLIENT_ORIGIN=http://localhost:3000
